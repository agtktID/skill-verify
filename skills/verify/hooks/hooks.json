{
  "_comment": "Hooks Claude Code pour le skill verify — auto-trigger après tâche complétée.",
  "_install": "Copier ce fichier dans .claude/hooks/hooks.json (ou fusionner avec l'existant).",
  "hooks": [
    {
      "event": "PostToolUse",
      "matchers": [
        { "tool_name": "Bash" }
      ],
      "hooks": [
        {
          "type": "command",
          "command": "bash .claude/hooks/post-task.sh",
          "timeout": 60
        }
      ]
    },
    {
      "event": "Stop",
      "matchers": [{}],
      "hooks": [
        {
          "type": "command",
          "command": "bash .claude/hooks/post-task.sh",
          "timeout": 60
        }
      ]
    }
  ]
}
